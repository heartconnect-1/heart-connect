{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "heart-connect-edge-router",
  "main": "cloudflare/worker-native-v1.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": true,
  "cache": {
    "enabled": false
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "royal-heart.com/*",
      "zone_name": "royal-heart.com"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "vars": {
    "BOOKING_ADMIN_EMAIL": "admin@royal-heart.com",
    "SUPABASE_URL": "https://zzhzkikezjtbntaqiurk.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HB0Irz6bxug1hHs518oPZQ_LC83i4qT"
  }
}